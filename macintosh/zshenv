# Functions
my_rm_wrapper() {
    mv $@ ~/.trash
}

extract () {
    if [ -f $1 ] ; then
      case $1 in
        *.tar.bz2)   tar xjf $1     ;;
        *.tar.gz)    tar xzf $1     ;;
        *.bz2)       bunzip2 $1     ;;
        *.rar)       unrar e $1     ;;
        *.gz)        gunzip $1      ;;
        *.tar)       tar xf $1      ;;
        *.tbz2)      tar xjf $1     ;;
        *.tgz)       tar xzf $1     ;;
        *.zip)       unzip $1       ;;
        *.Z)         uncompress $1  ;;
        *.7z)        7z x $1        ;;
        *)     echo "'$1' cannot be extracted via extract()" ;;
         esac
     else
         echo "'$1' is not a valid file"
     fi
}

mcd() {
    mkdir -p "$1" && cd "$1";
}

authme() {
  ssh "$1" 'mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys' \
    < ~/.ssh/id_rsa.pub
}

t() {
    tail -f $1 | perl -pe "s/$2/\e[1;31;43m$&\e[0m/g"
}

# echo wrapper
myecho () {
    echo $0 `date "+%Y-%m-%d %H:%M:%S"` "$@"
}

# Fire up tmux as dev windows.
dev() {
  if ! [[ $# -gt 0 ]]; then
    echo "Expect Tmux session name. None provided."
  fi
  echo "Session name: [$1]"

  # You can pass in `claude`/`opencode`/`codex` or other CLI for your own preference.
  local _agent_command="${2:-coco}"

  # Check if _agent_command exists
  if ! type "${_agent_command}" >/dev/null 2>&1; then
    echo "command '${_agent_command}' not found"
    return 1
  fi

  if ! type tmux >/dev/null 2>&1; then
    echo "Tmux command not found"
    return 1
  fi

  local _main="main"
  local _second="second"
  local _heavenly_king_1="Dhṛtarāṣṭra-Planner"
  local _heavenly_king_2="Virūḍhaka-Searcher"
  local _heavenly_king_3="Virūpākṣa-Investigator"
  local _heavenly_king_4="Vaiśravaṇa-Rounder"

  # Create first window with 5 panes. And then create second window with 8 panes.
  tmux a -t "$1" || {
    echo "creating new workspace ${1}"
    tmux \
      new -s "$1" -n "$_main" \; \
      splitw -h -p 50 -t "$1:${_main}.1" "${_agent_command}" \; \
      splitw -h -p 50 -t "$1:${_main}.2" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_main}.2" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_main}.4" "${_agent_command}" \; \
      select-pane -t "$1:${_main}.1" -T 'MonkeyNeverCramp' \; \
      select-pane -t "$1:${_main}.2" -T "${_heavenly_king_1}" \; \
      select-pane -t "$1:${_main}.3" -T "${_heavenly_king_2}" \; \
      select-pane -t "$1:${_main}.4" -T "${_heavenly_king_3}" \; \
      select-pane -t "$1:${_main}.5" -T "${_heavenly_king_4}" \; \
      new-window -n "$_second" "${_agent_command}" \; \
      splitw -h -p 40 -t "$1:${_second}.1" "${_agent_command}" \; \
      splitw -h -p 50 -t "$1:${_second}.1" "${_agent_command}" \; \
      splitw -h -p 50 -t "$1:${_second}.3" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_second}.1" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_second}.3" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_second}.5" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_second}.7" "${_agent_command}" \; \
      select-pane -t "$1:${_second}.1" -T "coder1" \; \
      select-pane -t "$1:${_second}.2" -T "coder2" \; \
      select-pane -t "$1:${_second}.3" -T "coder3" \; \
      select-pane -t "$1:${_second}.4" -T "coder4" \; \
      select-pane -t "$1:${_second}.5" -T "unit tester1" \; \
      select-pane -t "$1:${_second}.6" -T "unit tester2" \; \
      select-pane -t "$1:${_second}.7" -T "integration tester" \; \
      select-pane -t "$1:${_second}.8" -T "reviewer" \; \
      selectp -t 1 \; \
      select-window -t "$1:${_main}" \; \
      selectp -t 1
  }
}

