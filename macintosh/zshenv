# History management.
HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
HIST_STAMPS="mm/dd/yyyy"
SAVEHIST=10000
HISTSIZE=10000
# Set max bash history size.
setopt EXTENDED_HISTORY
# share history across multiple zsh sessions
setopt SHARE_HISTORY
# append to history
setopt APPEND_HISTORY
# adds commands as they are typed, not at shell exit
setopt INC_APPEND_HISTORY
# expire duplicates first
setopt HIST_EXPIRE_DUPS_FIRST
# do not store duplications
setopt HIST_IGNORE_DUPS
#ignore duplicates when searching
setopt HIST_FIND_NO_DUPS
# removes blank lines from history
setopt HIST_REDUCE_BLANKS
# If within Tmux pane, trace its own command history.
if [[ $TMUX_PANE ]]; then
  HISTFILE=$HOME/.bash_history_tmux_${TMUX_PANE:1}
fi

# setup git env variables so the branch name will show up in bash prompt.
uname=`uname`
case $uname in
    Darwin)
        if [ -f "/opt/homebrew/opt/bash-git-prompt/share/gitprompt.sh" ]; then
          __GIT_PROMPT_DIR="/opt/homebrew/opt/bash-git-prompt/share"
          source "/opt/homebrew/opt/bash-git-prompt/share/gitprompt.sh"
        fi
        ;;
    Linux)
        source /etc/bash_completion.d/git
        ;;
    *)
        echo "Unknown platform ${uname}. Fail to set git branch env var..."
        ;;
esac

# Case insensitive globbing.
setopt NO_CASE_GLOB
setopt GLOB_COMPLETE

export CLICOLOR=1

# Ignore history by adding heading space.
export HISTIGNORE=' *'
# Set JAVA_HOME.
# export JAVA_HOME=$(/usr/libexec/java_home)
JAVA_HOME='/opt/homebrew/opt/openjdk@11/libexec/openjdk.jdk/Contents/Home'

#
# Alias
#
alias lr='ls -R | grep ":$" | sed -e '\''s/:$//'\'' -e '\''s/[^-][^\/]*\//--/g'\'' -e '\''s/^/   /'\'' -e '\''s/-/|/'\'' | less'
alias rm='my_rm_wrapper'
# git formaated log with colors.
alias gl="git log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit"
alias gs="git status"
# clear shortcut
alias c='clear'
# Screen
alias sc="screen -S"
alias sl="screen -ls"
alias sr="screen -r"
# Backing out of the current directory.
setopt AUTO_CD  # Support ``..`
alias ...='cd ../../'
alias ....='cd ../../../'
alias .....='cd ../../../../'
alias ......='cd ../../../../../'

# Functions
my_rm_wrapper() {
    mv $@ ~/.trash
}

extract () {
    if [ -f $1 ] ; then
      case $1 in
        *.tar.bz2)   tar xjf $1     ;;
        *.tar.gz)    tar xzf $1     ;;
        *.bz2)       bunzip2 $1     ;;
        *.rar)       unrar e $1     ;;
        *.gz)        gunzip $1      ;;
        *.tar)       tar xf $1      ;;
        *.tbz2)      tar xjf $1     ;;
        *.tgz)       tar xzf $1     ;;
        *.zip)       unzip $1       ;;
        *.Z)         uncompress $1  ;;
        *.7z)        7z x $1        ;;
        *)     echo "'$1' cannot be extracted via extract()" ;;
         esac
     else
         echo "'$1' is not a valid file"
     fi
}

mcd() {
    mkdir -p "$1" && cd "$1";
}

authme() {
  ssh "$1" 'mkdir -p ~/.ssh && cat >> ~/.ssh/authorized_keys' \
    < ~/.ssh/id_rsa.pub
}

t() {
    tail -f $1 | perl -pe "s/$2/\e[1;31;43m$&\e[0m/g"
}

# echo wrapper
myecho () {
    echo $0 `date "+%Y-%m-%d %H:%M:%S"` "$@"
}

# Fire up tmux as dev windows.
dev() {
  if ! [[ $# -gt 0 ]]; then
    echo "Expect Tmux session name. None provided."
  fi
  echo "Session name: [$1]"

  # You can pass in `claude`/`opencode`/`codex` or other CLI for your own preference.
  local _agent_command="${2:-traecli}"

  # Check if _agent_command exists
  if ! type "${_agent_command}" >/dev/null 2>&1; then
    echo "command '${_agent_command}' not found"
    return 1
  fi

  if ! type tmux >/dev/null 2>&1; then
    echo "Tmux command not found"
    return 1
  fi

  local _main="main"
  local _second="second"
  local _heavenly_king_1="Dhṛtarāṣṭra-Planner"
  local _heavenly_king_2="Virūḍhaka-Searcher"
  local _heavenly_king_3="Virūpākṣa-Investigator"
  local _heavenly_king_4="Vaiśravaṇa-Rounder"

  # Create first window with 5 panes. And then create second window with 8 panes.
  tmux a -t "$1" || {
    echo "creating new workspace ${1}"
    tmux \
      new -s "$1" -n "$_main" "${_agent_command}"\; \
      splitw -h -p 70 -t "$1:${_main}.1" \; \
      splitw -h -p 40 -t "$1:${_main}.2" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_main}.1" "${_agent_command}" \; \
      splitw -v -p 50 -t "$1:${_main}.4" "${_agent_command}" \; \
      select-pane -t "$1:${_main}.1" -T "${_heavenly_king_2}" \; \
      select-pane -t "$1:${_main}.2" -T "${_heavenly_king_1}" \; \
      select-pane -t "$1:${_main}.3" -T 'MonkeyNeverCramp' \; \
      select-pane -t "$1:${_main}.4" -T "${_heavenly_king_3}" \; \
      select-pane -t "$1:${_main}.5" -T "${_heavenly_king_4}" \; \
      new-window -n "$_second" \; \
      splitw -h -p 40 -t "$1:${_second}.1" \; \
      splitw -h -p 50 -t "$1:${_second}.1" \; \
      splitw -h -p 50 -t "$1:${_second}.3" \; \
      splitw -v -p 50 -t "$1:${_second}.1" \; \
      splitw -v -p 50 -t "$1:${_second}.3" \; \
      splitw -v -p 50 -t "$1:${_second}.5" \; \
      splitw -v -p 50 -t "$1:${_second}.7" \; \
      select-pane -t "$1:${_second}.1" -T "coder1" \; \
      select-pane -t "$1:${_second}.2" -T "coder2" \; \
      select-pane -t "$1:${_second}.3" -T "coder3" \; \
      select-pane -t "$1:${_second}.4" -T "coder4" \; \
      select-pane -t "$1:${_second}.5" -T "unit tester1" \; \
      select-pane -t "$1:${_second}.6" -T "unit tester2" \; \
      select-pane -t "$1:${_second}.7" -T "integration tester" \; \
      select-pane -t "$1:${_second}.8" -T "reviewer" \; \
      send-keys -t "$1:${_second}.1" "${_agent_command}" C-m \; \
      send-keys -t "$1:${_second}.2" "${_agent_command}" C-m \; \
      send-keys -t "$1:${_second}.3" "${_agent_command}" C-m \; \
      send-keys -t "$1:${_second}.4" "${_agent_command}" C-m \; \
      send-keys -t "$1:${_second}.5" "${_agent_command}" C-m \; \
      send-keys -t "$1:${_second}.6" "${_agent_command}" C-m \; \
      send-keys -t "$1:${_second}.7" "${_agent_command}" C-m \; \
      send-keys -t "$1:${_second}.8" "${_agent_command}" C-m \; \
      selectp -t 1 \; \
      select-window -t "$1:${_main}" \; \
      selectp -t 1
  }
}
